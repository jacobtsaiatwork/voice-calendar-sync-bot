# ---------------------------------------------------------
# 1. LINE Messaging API 憑證
# ---------------------------------------------------------
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ---------------------------------------------------------
# 2. Google Gemini API 金鑰 (支援 M4A 語音轉譯與自然語言結構化；若未設定自動啟用本地高精度 NLP 引擎)
# ---------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------
# 3. Google Calendar & Google Tasks 雙向同步設定
# (未設定雲端憑證時，系統自動以 Local Sync Twin 雙向鏡像模式運作，並支援 .ics / Deep Link 一鍵匯出)
# ---------------------------------------------------------
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASKLIST_ID=@default
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_CALENDAR_ICAL_URLS=
DEFAULT_TIMEZONE=Asia/Taipei

# ---------------------------------------------------------
# 4. 資料庫與服務網址設定
# ---------------------------------------------------------
DATABASE_URL=sqlite:///./voice_calendar_sync.db
PUBLIC_BASE_URL=https://voice-calendar-sync-bot.vercel.app
PORT=8000
